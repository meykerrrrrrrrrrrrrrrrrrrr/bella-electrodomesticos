# ============================================================================
# bella Electrodomésticos Colombia — Variables de Entorno del Servidor
# IMPORTANTE: Copia este archivo a `.env.local` en tu servidor local o configura
# estas variables en Vercel Dashboard -> Settings -> Environment Variables.
# NUNCA subas `.env.local` ni llaves reales al código fuente ni a GitHub.
# ============================================================================

# Clave maestra del propietario para desbloquear la base de datos privada y roles administrativos
BELLA_OWNER_ACCESS_CODE=

# API Key privada del servidor para integraciones y cabeceras X-Bella-Api-Key
BELLA_API_KEY=

# Secreto HMAC-SHA256 del servidor para firmar sesiones de propietario
BELLA_OWNER_SECRET=

# Llave de cifrado AES-256-GCM en reposo para la bóveda privada de base de datos (.private_db)
BELLA_DB_ENCRYPTION_KEY=
