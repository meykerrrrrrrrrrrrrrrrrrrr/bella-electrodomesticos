# ============================================================================
# BELLA ELECTRODOMÉSTICOS COLOMBIA — VARIABLES DE ENTORNO DEL SERVIDOR
# Configura estas variables en tu servidor o en Vercel Dashboard -> Settings -> Environment Variables.
# NUNCA subas credenciales reales a repositorios públicos de GitHub.
# ============================================================================

# 1. Clave de Facturación (Módulo de Pedidos y Facturas DIAN)
BELLA_FACTURACION_CODE=BELLA-FACTURA-2026

# 2. Clave de Administrador (Módulo de Inventario, Bodegas y Ofertas)
BELLA_ADMIN_CODE=BELLA-ADMIN-2026

# 3. Clave de Administrador General / Propietario Root (Acceso Total Maestro)
BELLA_OWNER_ACCESS_CODE=BELLA-ROOT-2026

# API Key y Secretos de Cifrado AES-256-GCM del Servidor
BELLA_API_KEY=
BELLA_OWNER_SECRET=
BELLA_DB_ENCRYPTION_KEY=
